#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";
                // layer 0
                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | ESC  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | SHFT |
//                    | CTRL | LWR | SPC |   | ENT | RSE  | GUI |
                        label = "QWERTY";
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp ESC   &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                  &kp LCTRL &mo 1 &kp SPACE   &kp RET &mo 2 &kp RGUI
                        >;
                };

                // layer 1
                lower_layer {
// -----------------------------------------------------------------------------------------
// | caps |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | ALT  |     |     |     |     |     |   | LFT | DWN |  UP | RGT |     | ALT  |
// | F1   | F2  | F3  |  F4 | F5  | F6  |   | F7  | F8  |  F9 | F10 | F11 | F12  |
//                    | CTRL |     | SPC |   | ENT | BOTH | GUI |
                        label = "NUMBER";
                        bindings = <
   &kp CAPS    &kp N1       &kp N2       &kp N3        &kp N4      &kp N5      &kp N6   &kp N7   &kp N8 &kp N9     &kp N0  &kp BSPC
   &kp LALT    &trans       &trans       &trans        &trans      &trans      &kp LEFT &kp DOWN &kp UP &kp RIGHT  &trans  &kp RALT
   &kp F1      &kp F2       &kp F3       &kp F4        &kp F5      &kp F6      &kp F7   &kp F8   &kp F9 &kp F10    &kp F11 &kp F12
                                         &kp LCTRL     &trans      &kp SPACE   &kp RET  &mo 3    &kp RGUI
                        >;
                };
                // layer 2
                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | ESC  |     |  \  |  -  |  `  |  (  |   |  )  |  {  |  }  |  =  |  ;  |  '   |
// | SHFT |     |  |  |  _  |  ~  |     |   |     |  [  |  ]  |  +  |     |      |
//                    | CTRL| BOTH| SPC |   | ENT |     | GUI |
                        label = "SYMBOL";
                        bindings = <
   &kp TAB   &kp EXCL &kp AT    &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &kp BSPC
   &kp ESC   &none    &kp BSLH  &kp MINUS &kp GRAVE &kp LPAR    &kp RPAR  &kp LBRC  &kp RBRC        &kp EQUAL &kp SEMI  &kp SQT
   &kp LSHFT &none    &kp PIPE  &kp UNDER &kp TILDE &none       &none     &kp LBKT  &kp RBKT        &kp PLUS  &none     &none
                    	          &kp LCTRL &mo 3     &kp SPACE   &kp RET   &trans    &kp RGUI
                        >;
                };
                // layer 3
                both_layer {
// -----------------------------------------------------------------------------------------
// | BT_C |      |      |      |      |      |       |       |       |      |     |     |      |
// |      | BT_0 | BT_1 | BT_2 | BT_3 | BT_3 | BT_4  | VOLDN | VOLUP | MUTE |     |     |      |
// |      |      |      |      |      | GAME |       | BRIUP | BRIDN |      |     |     |      |
//                      |      |      |      |       |       |       |      |

                        label = "RANDOM";
                        bindings = <
   &bt BT_CLR &none         &none         &none         &none         &none           &none &none         &none         &none       &none &none 
   &none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &none &none 
   &none      &none         &none         &none         &none         &none           &none &kp C_BRI_DN  &kp C_BRI_UP  &none       &none &none 
                                          &none         &trans        &none           &none &trans        &none 
                        >;
                };
        };
};
